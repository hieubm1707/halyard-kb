# Gemini API key from aistudio.google.com. Not needed with --dry-run.
API_KEY=

# Optional: use a specific store (fileSearchStores/...). Otherwise one with
# FILE_SEARCH_STORE_DISPLAY_NAME is found or created, and its name is logged.
FILE_SEARCH_STORE=
FILE_SEARCH_STORE_DISPLAY_NAME=support-kb

# Optional: limit the scrape, e.g. 30 for a quick test. Article removal is off while set.
MAX_ARTICLES=

# ask.py only
GEMINI_MODEL=gemini-3.6-flash
